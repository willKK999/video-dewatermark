# LOCAL DEVELOPMENT ONLY. Replace all credentials for a real deployment.
API_TOKENS='{"local-development-token-change-me":"demo"}'
DATABASE_URL=postgres://watermark:watermark-local-only@localhost:5432/watermark?sslmode=disable
POSTGRES_PASSWORD=watermark-local-only
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_SECURE=false
S3_REGION=us-east-1
S3_BUCKET=watermark
S3_ACCESS_KEY=watermark-local
S3_SECRET_KEY=watermark-local-secret
AUTO_MIGRATE=true
PIPELINE_VERSION=mvp-1-dev
INPAINT_ENGINE=telea-dev
WORK_DIR=work
MAX_PENDING_JOBS=10
