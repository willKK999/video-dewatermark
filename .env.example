# LOCAL DEVELOPMENT ONLY. Replace all credentials for a real deployment.
API_TOKENS='{"local-development-token-change-me":"demo"}'
DATABASE_URL=postgres://watermark:watermark-local-only@localhost:5432/watermark?sslmode=disable
POSTGRES_PASSWORD=watermark-local-only
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_SECURE=false
S3_REGION=us-east-1
S3_BUCKET=watermark
S3_ACCESS_KEY=watermark-local
S3_SECRET_KEY=watermark-local-secret
AUTO_MIGRATE=true
PIPELINE_VERSION=mvp-1-dev
INPAINT_ENGINE=telea-dev
WORK_DIR=work
MAX_PENDING_JOBS=10

# 通用自动检测策略（所有视频使用相同参数）
YOLO_CONFIDENCE=0.35
BOX_PAD_RATIO=0.08
BOX_PAD_MIN=4
MASK_PAD_RATIO=0.004
SHOT_HIST_THRESHOLD=0.5
SHOT_PIXEL_THRESHOLD=0.18
MASK_JUMP_ABSOLUTE=0.015
MASK_JUMP_RATIO=3
RESIDUAL_CONFIDENCE=0.65
RESIDUAL_FRACTION=0.25

DETECTION_MAX_GAP=10
SHOT_CHANGED_FRACTION=0.5

# 存储不支持对象标签时显式关闭，仍保留摘要和分类元数据
S3_OBJECT_TAGGING=true
MASK_PAD_MIN=3
MASK_PAD_BOX_RATIO=0.12
