# syntax=docker/dockerfile:1
FROM python:3.10.16-slim-bookworm
RUN --mount=type=secret,id=proxy_ca,required=true \
    apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY worker/requirements.txt ./requirements.txt
RUN --mount=type=secret,id=proxy_ca,required=true PIP_CERT=/run/secrets/proxy_ca pip install --no-cache-dir -r requirements.txt
COPY worker ./worker
RUN useradd -u 10001 app && mkdir /work && chown app /work
USER 10001
CMD ["python", "-m", "worker.main"]
